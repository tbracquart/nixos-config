diff --git a/howdy/src/pam/main.cc b/howdy/src/pam/main.cc
--- a/howdy/src/pam/main.cc
+++ b/howdy/src/pam/main.cc
@@ -1650,15 +1650,18 @@
   if (confirmation_type == ConfirmationType::Pam) {
-    // We kill the child because we don't need its result
-    kill(child_pid, SIGTERM);
-    child_task.stop(false);
-
     // We just wait for the thread to stop since it's this one which sent us the
     // confirmation type
     pass_task.stop(false);

     char *password = nullptr;
     std::tie(pam_res, password) = pass_task.get();

     if (pam_res != PAM_SUCCESS) {
       return pam_res;
     }

-    // The password has been entered, we are passing it to PAM stack
-    return PAM_IGNORE;
+    // An empty password can be an intentional submit used to start
+    // biometric authentication (for example by a graphical lock screen).
+    // It is not a password authentication result, so keep Howdy's face
+    // recognition running instead of killing it and returning PAM_IGNORE.
+    if (password != nullptr && password[0] != '\0') {
+      // A real password was entered, so Howdy is not the winner.
+      kill(child_pid, SIGTERM);
+      child_task.stop(false);
+      return PAM_IGNORE;
+    }
+
+    // The conversation completed with an empty password. Continue with the
+    // facial authentication result below.
   }
