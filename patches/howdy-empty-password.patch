diff --git a/howdy/src/pam/main.cc b/howdy/src/pam/main.cc
--- a/howdy/src/pam/main.cc
+++ b/howdy/src/pam/main.cc
@@ -331,20 +331,26 @@
+  bool empty_password_submission = false;
+
   // The password has been entered or an error has occurred
   if (confirmation_type == ConfirmationType::Pam) {
-    // We kill the child because we don't need its result
-    kill(child_pid, SIGTERM);
-    child_task.stop(false);
-
     // We just wait for the thread to stop since it's this one which sent us the
     // confirmation type
     pass_task.stop(false);
-
     char *password = nullptr;
     std::tie(pam_res, password) = pass_task.get();
-
     if (pam_res != PAM_SUCCESS) {
       return pam_res;
     }
-
     // The password has been entered, we are passing it to PAM stack
-    return PAM_IGNORE;
+    // A graphical PAM client can submit an empty password just to start
+    // authentication (for example Noctalia). This completes pam_get_authtok,
+    // but it is not a real password authentication result. Keep Howdy's face
+    // recognition running instead of killing the compare process.
+    if (password == nullptr || password[0] == '\0') {
+      empty_password_submission = true;
+    } else {
+      // A real password was entered, so Howdy is not the winner.
+      kill(child_pid, SIGTERM);
+      child_task.stop(false);
+      return PAM_IGNORE;
+    }
   }
@@ -358,17 +364,18 @@
   // If python process ran into a timeout
   // Do not send enter presses or terminate the PAM function, as the user might
   // still be typing their password
-  if (WIFEXITED(status) && WEXITSTATUS(status) != EXIT_SUCCESS && ask_pass) {
+  if (!empty_password_submission &&
+      WIFEXITED(status) && WEXITSTATUS(status) != EXIT_SUCCESS && ask_pass) {
     // Wait for the password to be typed
     pass_task.stop(false);
 
     char *password = nullptr;
     std::tie(pam_res, password) = pass_task.get();
 
     if (pam_res != PAM_SUCCESS) {
       return howdy_status(username, status, config, conv_function);
     }
 
     // The password has been entered, we are passing it to PAM stack
     return PAM_IGNORE;
   }
@@ -376,4 +383,12 @@
   // We want to stop the password prompt, either by canceling the thread when
   // workaround is set to "native", or by emulating "Enter" input with
   // "input"
 
+  // The password conversation has already completed with an empty password.
+  // There is no active password prompt for the input workaround to submit to,
+  // so do not touch pass_task again (its future has already been consumed).
+  // Return Howdy's face result instead.
+  if (empty_password_submission) {
+    return howdy_status(username, status, config, conv_function);
+  }
+
